generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Scene {
  id            Int            @id @default(autoincrement())
  title         String         @default("Scène")
  sceneCapsules SceneCapsule[]
  sceneContents SceneContent[]

  capsuleId Int?     @unique @map("capsule_id")
  capsule   Capsule? @relation(fields: [capsuleId], references: [id])

  decorId Int?   @unique @map("decor_id") // basé sur  // name
  decor   Decor? @relation(fields: [decorId], references: [id])

  themeId Int?   @unique @map("theme_id") // basé sur  // name
  theme   Theme? @relation(fields: [themeId], references: [id])

  @@map("scene")
}

model SceneCapsule {
  id Int @id @default(autoincrement())

  sceneId Int   @map("scene_id")
  scene   Scene @relation(fields: [sceneId], references: [id])

  capsuleId Int      @map("capsule_id")
  capsule   Capsule? @relation(fields: [capsuleId], references: [id])

  @@map("scene_capsule")
}

model SceneContent {
  id     Int    @id @default(autoincrement())
  order  Int
  events String // JSON

  contentId Int     @map("content_id")
  content   Content @relation(fields: [contentId], references: [id])

  sceneId Int   @map("scene_id")
  scene   Scene @relation(fields: [sceneId], references: [id])

  decorId Int?   @map("decor_id") // basé sur  // name
  decor   Decor? @relation(fields: [decorId], references: [id])

  @@map("scene_content")
}

model Capsule {
  id                         Int     @id @default(autoincrement())
  name                       String
  type                       String?
  grid                       String?
  defaultItemIntroTransition String? @map("default_item_intro_transition")
  defaultItemOutroTransition String? @map("default_item_outro_transition")

  items         Item[]
  sceneCapsules SceneCapsule[]
  itemTargets   ItemTarget[]

  scene    Scene?
  contents Content[]

  @@map("capsule")
}

model Item {
  id     Int     @id @default(autoincrement())
  order  Int
  events Event[]

  contentId Int     @map("content_id")
  content   Content @relation(fields: [contentId], references: [id])

  capsuleId Int      @map("capsule_id")
  capsule   Capsule? @relation(fields: [capsuleId], references: [id])

  decorId Int?   @unique @map("decor_id") // basé sur  // name
  decor   Decor? @relation(fields: [decorId], references: [id])

  @@map("item")
}

// enum TypeMedia {
//   img
//   text
//   son
//   video
//   capsule
// }

model Content {
  id    Int     @id @default(autoincrement())
  name  String  @default("")
  type  String
  path  String?
  inner String?
  lang  String?

  capsuleId Int?     @map("capsule_id")
  capsule   Capsule? @relation(fields: [capsuleId], references: [id])

  items         Item[]
  sceneContents SceneContent[]

  @@map("content")
}

/**
 * name : event name (on sound)
 * action: element action
 * ref : content of action
 */
model Event {
  id       Int    @id @default(autoincrement())
  name     String
  action   String
  ref      String // référence nommée dans une config, sans décor 
  duration Int?
  delay    Int?

  itemId Int?  @map("item_id")
  item   Item? @relation(fields: [itemId], references: [id])

  decorId Int?   @unique @map("decor_id") // basé sur  // name
  decor   Decor? @relation(fields: [decorId], references: [id])

  @@unique([itemId, action])
  @@map("event")
}

model Decor {
  id        Int     @id @default(autoincrement())
  name      String?
  style     String? // JSON
  className String?
  area      String?

  itemTargetId Int?        @map("item_target_id")
  itemTarget   ItemTarget? @relation(fields: [itemTargetId], references: [id])

  basedUpon Int?    @map("based_upon") // ref decor id  // name
  bases     Decor[] @relation("basedUpon")
  base      Decor?  @relation("basedUpon", fields: [basedUpon], references: [id])

  scenes        Scene[]
  sceneContents SceneContent[]
  events        Event[]
  items         Item[]

  @@map("decor")
}

model ItemTarget {
  id     Int     @id @default(autoincrement())
  order  Int? // ordre d'insertion dans la capsule ; n° du slot
  decors Decor[]

  targetId Int     @map("target_id") // capsuleId
  capsule  Capsule @relation(fields: [targetId], references: [id])

  @@map("item_target")
}

model Theme {
  id        Int     @id @default(autoincrement())
  name      String?
  custom    String?
  generated String?

  scenes Scene[]

  @@map("theme")
}
